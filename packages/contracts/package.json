{
  "name": "@mitemo/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Types et interfaces partagés entre l'API, le web et le mobile.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.spec.ts\"",
    "test:ci": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-coverage-exclude=\"src/**/*.spec.ts\" \"src/**/*.spec.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
