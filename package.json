{
  "name": "mitemo",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0 && turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:scripts && turbo run test",
    "test:ci": "pnpm test:scripts && turbo run test:ci",
    "test:scripts": "node --test scripts/",
    "test:affected": "pnpm test:scripts && turbo run typecheck test --filter=...[HEAD]",
    "audit:deps": "pnpm audit --audit-level=moderate",
    "commit:check": "node scripts/check-commit-message.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.3",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
