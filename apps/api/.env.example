# Port HTTP de l'API.
PORT=3000

# Connexion DIRECTE (non poolée) à PostgreSQL : écritures du grand livre et migrations Prisma.
# Sur Neon : l'URL sans le suffixe « -pooler » dans le nom d'hôte.
DATABASE_URL=postgresql://mitemo:mitemo@localhost:5432/mitemo

# Connexion POOLÉE : lectures simples uniquement (Neon : hôte avec « -pooler »).
DATABASE_POOLED_URL=postgresql://mitemo:mitemo@localhost:5432/mitemo

# Démonstration locale. Le mode distant nécessite une configuration distincte.
MITEMO_DEMO_AUTH=false
# MITEMO_DEPLOYMENT=preview
# MITEMO_PREVIEW_KEY=

# Réception des notifications signées PawaPay Sandbox sur Render Preview.
# PAWAPAY_SANDBOX_ENABLED=false
# PAWAPAY_SANDBOX_CALLBACK_KEY_ID=
# PAWAPAY_SANDBOX_CALLBACK_PUBLIC_KEY=
