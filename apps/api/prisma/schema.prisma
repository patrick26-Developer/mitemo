// Schéma de la base Mitemo. Les modèles arrivent avec les features (grand livre en premier).
// Montants : toujours BigInt, jamais Float ni Decimal (voir AGENTS.md, section 1.1).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Grand livre (issue #6). Aucun solde n'est stocké : il se calcule toujours à
// partir des imputations. Les garanties que Prisma ne sait pas exprimer
// (CHECK, interdiction de modifier, équilibre vérifié en fin de transaction)
// sont dans la migration SQL, et testées par les ledger-*.int-spec.ts.
// ---------------------------------------------------------------------------

/// Compte du grand livre. Ne se supprime jamais ; peut seulement être clôturé.
model LedgerAccount {
  /// Identifiant stable, par exemple « wallet:<userId> ».
  id       String              @id
  /// Nature du compte, limitée par une contrainte CHECK à LEDGER_ACCOUNT_KINDS.
  kind     String
  openedAt DateTime            @default(now()) @map("opened_at") @db.Timestamptz(3)
  /// Une fois renseignée, plus aucune imputation n'est acceptée sur le compte.
  closedAt DateTime?           @map("closed_at") @db.Timestamptz(3)
  lines    LedgerPostingLine[]

  walletOwner AppUser?

  @@map("ledger_account")
}

/// Écriture du grand livre, immuable une fois enregistrée.
model LedgerEntry {
  id              String              @id
  /// Clé d'idempotence : une même demande ne produit jamais deux écritures.
  idempotencyKey  String              @unique @map("idempotency_key")
  /// Empreinte du contenu, pour refuser une clé réutilisée avec un autre contenu.
  payloadHash     String              @map("payload_hash")
  /// Référence de l'opération métier à l'origine de l'écriture (ex. « funding:<id> »).
  operationRef    String              @map("operation_ref")
  description     String
  /// Date métier de l'opération.
  occurredAt      DateTime            @map("occurred_at") @db.Timestamptz(3)
  /// Date d'enregistrement, fixée par la base.
  recordedAt      DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// Auteur de l'enregistrement (utilisateur, simulateur, planificateur).
  recordedBy      String              @map("recorded_by")
  /// Mode de règlement. Seul « SIMULATED » est accepté par la base (ADR 0005).
  settlementMode  String              @map("settlement_mode")
  /// Écriture annulée par celle-ci ; une écriture ne s'annule qu'une fois.
  reversesEntryId String?             @unique @map("reverses_entry_id")
  reverses        LedgerEntry?        @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy      LedgerEntry?        @relation("Reversal")
  lines           LedgerPostingLine[]

  @@index([operationRef])
  @@map("ledger_entry")
}

/// Imputation d'une écriture sur un compte. Montant signé, jamais nul.
model LedgerPostingLine {
  entryId   String        @map("entry_id")
  /// Rang de l'imputation dans l'écriture, à partir de 1.
  lineNo    Int           @map("line_no") @db.SmallInt
  accountId String        @map("account_id")
  /// FCFA entiers ; positif = le solde du compte augmente.
  amount    BigInt
  entry     LedgerEntry   @relation(fields: [entryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([entryId, lineNo])
  @@index([accountId])
  @@map("ledger_posting_line")
}

/// Compte de démonstration, avec justificatif haché et rôle attribué côté serveur.
model AppUser {
  id                          String                  @id @db.Uuid
  phoneNumber                 String                  @unique @map("phone_number")
  displayName                 String                  @map("display_name")
  pinHash                     String                  @map("pin_hash")
  isDemo                      Boolean                 @default(false) @map("is_demo")
  role                        String                  @default("USER")
  phoneVerifiedAt             DateTime?               @map("phone_verified_at") @db.Timestamptz(3)
  createdAt                   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  challenges                  AuthChallenge[]
  sessions                    AuthSession[]
  pushTokens                  NotificationPushToken[]
  savingsGoals                SavingsGoal[]
  registryGroups              TontineGroup[]
  registryMemberships         TontineMember[]
  registryInvitationsReceived TontineInvitation[]     @relation("RegistryRecipient")
  registryInvitationsSent     TontineInvitation[]     @relation("RegistryIssuer")
  registryAudit               AuditEvent[]

  walletAccountId String        @unique @map("wallet_account_id")
  walletAccount   LedgerAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("app_user")
}

/// Défi de connexion temporaire et à usage unique.
model AuthChallenge {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_challenge")
}

/// Session révocable, identifiée par le condensat du jeton.
model AuthSession {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique @map("token_hash")
  deviceLabel String?  @map("device_label")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_session")
}

/// Notification de simulation PawaPay, indépendante des écritures du grand livre.
model PawaPaySandboxReceipt {
  kind       String
  id         String   @db.Uuid
  status     String
  amount     BigInt
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@id([kind, id, status, amount])
  @@map("pawapay_sandbox_receipt")
}

/// Calendrier prévisionnel d’un objectif individuel, sans mouvement financier.
model SavingsGoal {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  user                 AppUser  @relation(fields: [userId], references: [id], onDelete: Restrict)
  name                 String
  installmentAmount    BigInt   @map("installment_amount")
  frequency            String
  installmentsPerCycle Int      @map("installments_per_cycle")
  cycleCount           Int      @map("cycle_count")
  startsAt             DateTime @map("starts_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt, id])
  @@map("savings_goal")
}

/// Jeton de notification enregistré par le titulaire d’une session.
model NotificationPushToken {
  userId       String   @map("user_id") @db.Uuid
  user         AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String
  platform     String
  appVersion   String   @map("app_version")
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz(3)

  @@id([userId, token])
  @@map("notification_push_token")
}

/// Groupe déclaratif gratuit, indépendant de toute caisse financière.
model TontineGroup {
  id                 String              @id @db.Uuid
  name               String
  creationName       String              @map("creation_name")
  ownerId            String              @map("owner_id") @db.Uuid
  contributionAmount BigInt              @map("contribution_amount")
  participantCount   Int                 @map("participant_count")
  frequencyUnit      String              @map("frequency_unit")
  frequencyInterval  Int                 @map("frequency_interval")
  state              String              @default("RECRUTEMENT")
  mode               String              @default("REGISTRY")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  owner              AppUser             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  audit              AuditEvent[]
  members            TontineMember[]
  invitations        TontineInvitation[]
  policies           GroupFeePolicy[]

  @@index([ownerId])
  @@map("tontine_group")
}

/// Adhésion et acceptation de la version gratuite des règles.
model TontineMember {
  groupId       String       @map("group_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  role          String
  state         String       @default("ACTIF")
  policyVersion String       @map("policy_version")
  joinedAt      DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)
  user          AppUser      @relation(fields: [userId], references: [id], onDelete: Restrict)
  group         TontineGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  policy GroupFeePolicy @relation(fields: [groupId, policyVersion], references: [groupId, version], onDelete: Restrict, onUpdate: NoAction, map: "registry_accepted_policy")

  @@id([groupId, userId])
  @@index([userId])
  @@map("tontine_member")
}

/// Invitation nominative, acceptée uniquement par son destinataire authentifié.
model TontineInvitation {
  id          String       @id @db.Uuid
  groupId     String       @map("group_id") @db.Uuid
  recipientId String       @map("recipient_id") @db.Uuid
  issuedBy    String       @map("issued_by") @db.Uuid
  state       String       @default("PENDING")
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient   AppUser      @relation("RegistryRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  issuer      AppUser      @relation("RegistryIssuer", fields: [issuedBy], references: [id], onDelete: Restrict)
  group       TontineGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([groupId, recipientId])
  @@index([issuedBy])
  @@index([recipientId, state])
  @@map("tontine_invitation")
}

/// Version gratuite acceptée par chaque membre, immuable.
model GroupFeePolicy {
  groupId        String       @map("group_id") @db.Uuid
  version        String
  mode           String       @default("FREE")
  responsibleBps Int          @default(0) @map("responsible_bps")
  mitemoBps      Int          @default(0) @map("mitemo_bps")
  operatorFixed  BigInt       @default(0) @map("operator_fixed")
  effectiveAt    DateTime     @default(now()) @map("effective_at") @db.Timestamptz(3)
  group          TontineGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  acceptedBy TontineMember[]

  @@id([groupId, version])
  @@map("group_fee_policy")
}

/// Journal append-only des actions du registre, sans secrets.
model AuditEvent {
  id        String       @id @db.Uuid
  groupId   String       @map("group_id") @db.Uuid
  actorId   String       @map("actor_id") @db.Uuid
  action    String
  subjectId String       @map("subject_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  group     TontineGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  actor     AppUser      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@index([actorId])
  @@map("audit_event")
}
