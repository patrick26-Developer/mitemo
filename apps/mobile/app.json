{
  "expo": {
    "name": "Mitemo",
    "slug": "mitemo",
    "scheme": "mitemo",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mitemo utilise votre photo pour votre profil.",
          "cameraPermission": "Mitemo utilise l'appareil photo pour votre photo de profil."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-contacts",
        {
          "contactsPermission": "Mitemo lit vos contacts pour retrouver ceux qui ont déjà un compte et les ajouter à vos tontines."
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1136B3"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "reactCompiler": true
    }
  }
}
