{
  "expo": {
    "name": "Mitemo",
    "slug": "mitemo",
    "scheme": "mitemo",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mitemo utilise votre photo pour votre profil.",
          "cameraPermission": "Mitemo utilise l'appareil photo pour votre photo de profil."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ]
  }
}
