# URL de base de l'API, intégrée à la compilation par Expo (préfixe EXPO_PUBLIC_ obligatoire).
# Jamais de secret ici : toute variable EXPO_PUBLIC_ est lisible dans l'application publiée.
#
# HTTPS obligatoire. HTTP n'est toléré qu'en développement (__DEV__) vers la machine,
# l'émulateur Android (10.0.2.2) ou le réseau local (192.168.x.x, 10.x.x.x, 172.16-31.x.x).
# Une URL refusée (HTTP public, identifiants ou paramètres dans l'URL) bloque tout appel.
#
# Ne jamais mettre MITEMO_PREVIEW_KEY ici : elle serait lisible dans l'application.
EXPO_PUBLIC_API_URL=https://mitemo-api-dev.onrender.com
